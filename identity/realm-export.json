{
  "realm": "hris-platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "hris:super_admin", "description": "Full system access across all tenants" },
      { "name": "hris:tenant_admin", "description": "Full access within a single tenant" },
      { "name": "hris:hr_manager", "description": "HR management access within a tenant" },
      { "name": "hris:line_manager", "description": "Team management access" },
      { "name": "hris:employee", "description": "Self-service employee access" },
      { "name": "default-roles-hris-platform", "description": "Default roles", "composite": true, "composites": { "realm": ["hris:employee"] } }
    ]
  },
  "defaultRole": {
    "name": "default-roles-hris-platform",
    "composites": { "realm": ["hris:employee"] }
  },
  "clients": [
    {
      "clientId": "hris-portal",
      "name": "HRIS Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/auth/sso/callback",
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "https://portal.hris.example.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "https://portal.hris.example.com"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "user.attribute": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hris-core-api",
      "name": "HRIS Core API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "srms-api",
      "name": "SRMS Backend API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "eappraisal-api",
      "name": "eAppraisal Backend API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "eleave-api",
      "name": "eLeave Backend API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "super.admin",
      "email": "super.admin@hris.local",
      "firstName": "Super",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
      "realmRoles": ["hris:super_admin", "default-roles-hris-platform"],
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "username": "tenant.admin",
      "email": "tenant.admin@hris.local",
      "firstName": "Tenant",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
      "realmRoles": ["hris:tenant_admin", "default-roles-hris-platform"],
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "username": "hr.manager",
      "email": "hr.manager@hris.local",
      "firstName": "Ama",
      "lastName": "Mensah",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
      "realmRoles": ["hris:hr_manager", "default-roles-hris-platform"],
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "username": "line.manager",
      "email": "line.manager@hris.local",
      "firstName": "Kofi",
      "lastName": "Osei",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
      "realmRoles": ["hris:line_manager", "default-roles-hris-platform"],
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "username": "employee",
      "email": "employee@hris.local",
      "firstName": "Kwame",
      "lastName": "Asante",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
