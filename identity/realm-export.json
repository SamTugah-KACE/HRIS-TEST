{
  "realm": "hris-platform",
  "enabled": true,
  "emailTheme": "hris-platform",
  "loginTheme": "hris-platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5)",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "hris:super_admin", "description": "Full system access across all tenants" },
      { "name": "hris:tenant_admin", "description": "Full access within a single tenant" },
      { "name": "hris:hr_manager", "description": "HR management access within a tenant" },
      { "name": "hris:line_manager", "description": "Team management access" },
      { "name": "hris:employee", "description": "Self-service employee access" },
      { "name": "default-roles-hris-platform", "description": "Default roles", "composite": true, "composites": { "realm": ["hris:employee"] } }
    ]
  },
  "defaultRole": {
    "name": "default-roles-hris-platform",
    "composites": { "realm": ["hris:employee"] }
  },
  "clients": [
    {
      "clientId": "hris-portal",
      "name": "HRIS Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/auth/sso/callback",
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "https://gi-kace-hris-core-test.onrender.com/auth/sso/callback",
        "https://gi-kace-hris-portal-test.onrender.com/*",
        "https://portal.hris.example.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "https://gi-kace-hris-portal-test.onrender.com",
        "https://portal.hris.example.com"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "user.attribute": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hris-core-api",
      "name": "HRIS Core API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "srms-api",
      "name": "SRMS Backend API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "eappraisal-api",
      "name": "eAppraisal Backend API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "eleave-api",
      "name": "eLeave Backend API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ]
}
