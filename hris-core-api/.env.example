APP_NAME=HRIS Core API
APP_ENV=development
AUTH_MODE=keycloak

KEYCLOAK_ISSUER=https://keycloak.example.com/realms/hris-platform
KEYCLOAK_JWKS_URL=https://keycloak.example.com/realms/hris-platform/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE_HRIS_CORE=hris-core-api,hris-portal
KEYCLOAK_TOKEN_URL=
KEYCLOAK_AUTHORIZE_URL=
KEYCLOAK_END_SESSION_URL=
KEYCLOAK_CLIENT_ID_PORTAL=hris-portal
KEYCLOAK_CLIENT_SECRET_PORTAL=
PORTAL_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_ACCESS_MAX_AGE_SECONDS=300
AUTH_COOKIE_REFRESH_MAX_AGE_SECONDS=28800
AUTH_STATE_SECRET=
AUTH_STATE_TTL_SECONDS=300
AUTH_CSRF_ENABLED=true
AUTH_CSRF_COOKIE_NAME=hris_csrf_token
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_POST_LOGOUT_REDIRECT_PATH=/

TENANT_REGISTRY_BASE_URL=https://tenant-registry.example.com
TENANT_REGISTRY_ALLOW_FALLBACK=false
TENANT_REGISTRY_TIMEOUT_SECONDS=5
TENANT_REGISTRY_STARTUP_WAIT_RETRIES=60
TENANT_REGISTRY_STARTUP_RETRY_DELAY_SECONDS=5
TENANT_REGISTRY_STARTUP_WAIT_FAIL_OPEN=true
TENANT_REGISTRY_BASIC_AUTH_USERNAME=hris_core
TENANT_REGISTRY_BASIC_AUTH_PASSWORD=change-me

SRMS_BASE_URL=https://srms.gi-kace.com.gh
SRMS_INTEGRATION_TOKEN=
SRMS_SERVICE_TOKEN=
SRMS_APP_TYPE=
SRMS_SESSION_TOKEN=
SRMS_AUTO_SESSION_TOKEN=true
SRMS_EXTRA_HEADERS_JSON=
SRMS_PAYLOAD_SECURITY_MODE=auto
SRMS_PAYLOAD_SIGNING_SECRET=
SRMS_PAYLOAD_ENCRYPTION_SECRET=
SRMS_HRIS_SHARED_SECRET=
SRMS_HRIS_SERVICE_TOKEN=
MODULE_TOKEN_SECRET=
EAPPRAISAL_DOMAIN_TEMPLATE=https://appraisal.{subdomain}.com.gh
EAPPRAISAL_SERVICE_TOKEN=
EAPPRAISAL_REFRESH_TOKEN=
EAPPRAISAL_AUTO_REFRESH=true
EAPPRAISAL_SUBDOMAIN_HEADER=
EAPPRAISAL_COOKIE=
ENABLE_INTEGRATION_DEBUG_ENDPOINTS=false
ELEAVE_DOMAIN_TEMPLATE=https://{subdomain}.eleave.com.gh
ELEAVE_SERVICE_TOKEN=
ELEAVE_USE_TENANT_PATH=true

ENABLE_AUTO_SYNC_LOOP=false
AUTO_SYNC_INTERVAL_SECONDS=300
AUTO_SYNC_MAX_TENANTS=200
AUTO_SYNC_MAX_USERS_PER_TENANT=200
ENABLE_STARTUP_TENANT_INVENTORY_IMPORT=false
STARTUP_TENANT_INVENTORY_MAX_RECORDS=500

ENABLE_AUTO_PROVISION=false
AUTO_PROVISION_DRY_RUN=true
AUTO_PROVISION_ALLOWED_MODULES=eappraisal,eleave
AUTO_PROVISION_MAX_ACTIONS_PER_RUN=100
AUTO_PROVISION_STOP_ON_ERROR=true
AUTO_PROVISION_AUDIT_LOG_PATH=logs/auto_provision_audit.jsonl
EAPPRAISAL_PROVISION_USER_PATH=/api/hris/v1/integration/tenants/{tenant_id}/users/provision
ELEAVE_PROVISION_USER_PATH=/api/hris/v1/integration/tenants/{tenant_id}/users/provision

HTTP_CLIENT_TIMEOUT_SECONDS=5
AUTOMATION_STORE_DATABASE_URL=postgresql://hris:hris_secret@localhost:5432/hris_tenant_registry
AUTOMATION_STORE_SCHEMA=hris_automation
DB_AUTO_CREATE_ON_STARTUP=true
DB_BOOTSTRAP_ADMIN_URL=
DB_BOOTSTRAP_ADMIN_DATABASE=postgres
DB_BOOTSTRAP_CONNECT_RETRIES=5
DB_BOOTSTRAP_RETRY_DELAY_SECONDS=2
DB_BOOTSTRAP_TIMEOUT_SECONDS=5
STARTUP_PAUSE_AFTER_DB_CREATE_SECONDS=0
ENABLE_POST_DEPLOY_SYNC_AUTOMATION=false
POST_DEPLOY_WELCOME_EMAILS_ENABLED=false
ONBOARDING_AUTO_SYNC_NEW_TENANTS=true
ONBOARDING_AUTO_KEYCLOAK_PROVISION=false
ONBOARDING_WELCOME_EMAIL_ENABLED=false
ONBOARDING_WELCOME_MAX_USERS_PER_TENANT=2000
ONBOARDING_SEND_TEMP_PASSWORD_EMAIL=false
ONBOARDING_TEMP_PASSWORD_LENGTH=14
ONBOARDING_DEV_CREDENTIALS_EXPORT_ENABLED=false
ONBOARDING_DEV_CREDENTIALS_EXPORT_PATH=data/exports
ONBOARDING_DEV_FORCE_TEMP_PASSWORD=false
STORAGE_PROVIDER_STACK=s3,local
STORAGE_HEALTHCHECK_TTL_SECONDS=300
MEDIA_LOCAL_BASE_PATH=data/media
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PREFIX=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@hris.local
WELCOME_EMAIL_SUBJECT_TEMPLATE=Welcome to {brand_name} - {tenant_name}
WELCOME_EMAIL_BODY_TEMPLATE=Welcome to {brand_name} for {tenant_name}.\n\nPortal URL: {portal_url}\nUsername: {username}\n{password_line}\nSupport: {support_email}\n
TENANT_BRAND_NAME_DEFAULT=HRIS
TENANT_SUPPORT_EMAIL_DEFAULT=support@hris.local

KEYCLOAK_REALM=hris-platform
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# If you later add logging, etc., add variables here