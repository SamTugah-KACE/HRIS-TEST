APP_ENV=development
# Purpose: Network location used for core api base url.
CORE_API_BASE_URL=http://localhost:8000
# Purpose: Time limit for core api timeout seconds, in seconds.
CORE_API_TIMEOUT_SECONDS=15
# Purpose: Configures cors allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
