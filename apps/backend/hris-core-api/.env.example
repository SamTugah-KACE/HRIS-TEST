# Purpose: Configures app name.
APP_NAME=HRIS Core API
# Purpose: Configures app env.
# Options: development | staging | production | test.
# Purpose: Configures app env.
# Options: development | staging | production | test.
# Purpose: Configures app env.
# Options: development | staging | production | test.
# Purpose: Configures app env.
# Options: development | staging | production | test.
APP_ENV=development
# Purpose: Configures auth mode.
# Options: keycloak (product runtime); dev is test-only.
# Purpose: Configures auth mode.
# Options: keycloak (product runtime); dev is test-only.
# Purpose: Configures auth mode.
# Options: keycloak (product runtime); dev is test-only.
# Purpose: Configures auth mode.
# Options: keycloak (product runtime); dev is test-only.
AUTH_MODE=keycloak

# Purpose: Configures keycloak issuer.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/hris-platform
# Optional server-to-server address when Keycloak has a different internal Docker hostname.
KEYCLOAK_INTERNAL_BASE_URL=
# Purpose: Network location used for keycloak jwks url.
KEYCLOAK_JWKS_URL=https://keycloak.example.com/realms/hris-platform/protocol/openid-connect/certs
# Purpose: Configures keycloak audience hris core.
KEYCLOAK_AUDIENCE_HRIS_CORE=hris-core-api,hris-portal
# Purpose: Secret/configuration for keycloak token url; inject securely and never commit a real value.
KEYCLOAK_TOKEN_URL=
# Purpose: Network location used for keycloak authorize url.
KEYCLOAK_AUTHORIZE_URL=
# Purpose: Network location used for keycloak end session url.
KEYCLOAK_END_SESSION_URL=
# Purpose: Configures keycloak client id portal.
KEYCLOAK_CLIENT_ID_PORTAL=hris-portal
AUTH_SSO_CALLBACK_URL=http://localhost:8000/auth/sso/callback
KEYCLOAK_MANAGE_PORTAL_CLIENT_SETTINGS=true
# Purpose: Secret/configuration for keycloak client secret portal; inject securely and never commit a real value.
KEYCLOAK_CLIENT_SECRET_PORTAL=
# Purpose: Network location used for portal base url.
PORTAL_BASE_URL=http://localhost:5173
# Purpose: Configures cors allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Purpose: Secret/configuration for auth cookie secure; inject securely and never commit a real value.
AUTH_COOKIE_SECURE=false
# Purpose: Secret/configuration for auth cookie samesite; inject securely and never commit a real value.
AUTH_COOKIE_SAMESITE=lax
# Purpose: Secret/configuration for auth cookie domain; inject securely and never commit a real value.
AUTH_COOKIE_DOMAIN=
# Purpose: Secret/configuration for auth cookie access max age seconds; inject securely and never commit a real value.
AUTH_COOKIE_ACCESS_MAX_AGE_SECONDS=300
# Purpose: Secret/configuration for auth cookie refresh max age seconds; inject securely and never commit a real value.
AUTH_COOKIE_REFRESH_MAX_AGE_SECONDS=28800
# Purpose: Secret/configuration for auth state secret; inject securely and never commit a real value.
AUTH_STATE_SECRET=
# Purpose: Time limit for auth state ttl seconds, in seconds.
AUTH_STATE_TTL_SECONDS=300
# Purpose: Feature flag controlling auth csrf enabled.
AUTH_CSRF_ENABLED=true
# Purpose: Secret/configuration for auth csrf cookie name; inject securely and never commit a real value.
AUTH_CSRF_COOKIE_NAME=hris_csrf_token
# Purpose: Configures auth csrf header name.
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
# Purpose: Configures auth post logout redirect path.
AUTH_POST_LOGOUT_REDIRECT_PATH=/

# Purpose: Network location used for tenant registry base url.
TENANT_REGISTRY_BASE_URL=https://tenant-registry.example.com
# Purpose: Configures tenant registry allow fallback.
TENANT_REGISTRY_ALLOW_FALLBACK=false
# Purpose: Time limit for tenant registry timeout seconds, in seconds.
TENANT_REGISTRY_TIMEOUT_SECONDS=5
# Purpose: Numeric runtime limit for tenant registry startup wait retries.
TENANT_REGISTRY_STARTUP_WAIT_RETRIES=60
# Purpose: Time limit for tenant registry startup retry delay seconds, in seconds.
TENANT_REGISTRY_STARTUP_RETRY_DELAY_SECONDS=5
# Purpose: Configures tenant registry startup wait fail open.
TENANT_REGISTRY_STARTUP_WAIT_FAIL_OPEN=false
# Purpose: Configures tenant registry basic auth username.
TENANT_REGISTRY_BASIC_AUTH_USERNAME=hris_core
# Purpose: Secret/configuration for tenant registry basic auth password; inject securely and never commit a real value.
TENANT_REGISTRY_BASIC_AUTH_PASSWORD=change-me

# Purpose: Network location used for srms base url.
SRMS_BASE_URL=https://srms.gi-kace.com.gh
# Purpose: Secret/configuration for srms integration token; inject securely and never commit a real value.
SRMS_INTEGRATION_TOKEN=
# Purpose: Secret/configuration for srms service token; inject securely and never commit a real value.
SRMS_SERVICE_TOKEN=
# Purpose: Configures srms app type.
SRMS_APP_TYPE=
# Purpose: Secret/configuration for srms session token; inject securely and never commit a real value.
SRMS_SESSION_TOKEN=
# Purpose: Secret/configuration for srms auto session token; inject securely and never commit a real value.
SRMS_AUTO_SESSION_TOKEN=true
# Purpose: Configures srms extra headers json.
SRMS_EXTRA_HEADERS_JSON=
# Purpose: Configures srms payload security mode.
SRMS_PAYLOAD_SECURITY_MODE=auto
# Purpose: Secret/configuration for srms payload signing secret; inject securely and never commit a real value.
SRMS_PAYLOAD_SIGNING_SECRET=
# Purpose: Secret/configuration for srms payload encryption secret; inject securely and never commit a real value.
SRMS_PAYLOAD_ENCRYPTION_SECRET=
# Purpose: Secret/configuration for srms hris shared secret; inject securely and never commit a real value.
SRMS_HRIS_SHARED_SECRET=
# Purpose: Secret/configuration for srms hris service token; inject securely and never commit a real value.
SRMS_HRIS_SERVICE_TOKEN=
# Purpose: Secret/configuration for module token secret; inject securely and never commit a real value.
MODULE_TOKEN_SECRET=
# Purpose: Configures eappraisal domain template.
EAPPRAISAL_DOMAIN_TEMPLATE=https://appraisal.{subdomain}.com.gh
# Purpose: Secret/configuration for eappraisal service token; inject securely and never commit a real value.
EAPPRAISAL_SERVICE_TOKEN=
# Purpose: Secret/configuration for eappraisal refresh token; inject securely and never commit a real value.
EAPPRAISAL_REFRESH_TOKEN=
# Purpose: Configures eappraisal auto refresh.
EAPPRAISAL_AUTO_REFRESH=true
# Purpose: Configures eappraisal subdomain header.
EAPPRAISAL_SUBDOMAIN_HEADER=
# Purpose: Secret/configuration for eappraisal cookie; inject securely and never commit a real value.
EAPPRAISAL_COOKIE=
# Purpose: Network location used for eappraisal integration base url.
EAPPRAISAL_INTEGRATION_BASE_URL=
# Purpose: Secret/configuration for eappraisal hris shared secret; inject securely and never commit a real value.
EAPPRAISAL_HRIS_SHARED_SECRET=
# Purpose: Secret/configuration for eappraisal hris service token; inject securely and never commit a real value.
EAPPRAISAL_HRIS_SERVICE_TOKEN=
# Purpose: Feature flag controlling enable integration debug endpoints.
ENABLE_INTEGRATION_DEBUG_ENDPOINTS=false
# Purpose: Feature flag controlling enable all modules by default.
ENABLE_ALL_MODULES_BY_DEFAULT=false
# Purpose: Configures eleave domain template.
ELEAVE_DOMAIN_TEMPLATE=https://{subdomain}.eleave.com.gh
# Purpose: Secret/configuration for eleave service token; inject securely and never commit a real value.
ELEAVE_SERVICE_TOKEN=
# Purpose: Secret/configuration for eleave hris shared secret; inject securely and never commit a real value.
ELEAVE_HRIS_SHARED_SECRET=
# Purpose: Secret/configuration for eleave hris service token; inject securely and never commit a real value.
ELEAVE_HRIS_SERVICE_TOKEN=
# Purpose: Configures eleave use tenant path.
ELEAVE_USE_TENANT_PATH=true

# Native module UI links are launched through HRIS handoff; do not expose raw URLs to Portal.
# Purpose: Configures module launch expose native urls.
MODULE_LAUNCH_EXPOSE_NATIVE_URLS=false
# Allow http:// URLs in catalog (local dev only; keep false in production).
# Purpose: Configures module launch allow http.
MODULE_LAUNCH_ALLOW_HTTP=false
# Comma-separated hostname suffixes; when non-empty, native URLs must match (e.g. example.com,.mycompany.org).
# Purpose: Configures module launch host suffix allowlist.
MODULE_LAUNCH_HOST_SUFFIX_ALLOWLIST=
# How the portal should open validated native workspaces: new_tab | same_window
# Purpose: Configures module launch open mode.
# Options: same_window | new_tab.
# Purpose: Configures module launch open mode.
# Options: same_window | new_tab.
# Purpose: Configures module launch open mode.
# Options: same_window | new_tab.
# Purpose: Configures module launch open mode.
# Options: same_window | new_tab.
MODULE_LAUNCH_OPEN_MODE=same_window
# Purpose: Feature flag controlling module handoff enabled.
MODULE_HANDOFF_ENABLED=true
# Purpose: Time limit for module handoff ttl seconds, in seconds.
MODULE_HANDOFF_TTL_SECONDS=60
# Purpose: Configures module handoff issuer.
MODULE_HANDOFF_ISSUER=hris-core
# Purpose: Configures module service auth mode.
# Options: shared_secret | jwt_optional | jwt_strict.
# Purpose: Configures module service auth mode.
# Options: shared_secret | jwt_optional | jwt_strict.
# Purpose: Configures module service auth mode.
# Options: shared_secret | jwt_optional | jwt_strict.
# Purpose: Configures module service auth mode.
# Options: shared_secret | jwt_optional | jwt_strict.
MODULE_SERVICE_AUTH_MODE=shared_secret
# Purpose: Configures module service jwt issuer.
MODULE_SERVICE_JWT_ISSUER=
# Purpose: Configures module service jwt audience.
MODULE_SERVICE_JWT_AUDIENCE=hris-core-modules
# Purpose: Secret/configuration for module service jwt shared secret; inject securely and never commit a real value.
MODULE_SERVICE_JWT_SHARED_SECRET=
# Purpose: Configures module service jwt algorithms.
MODULE_SERVICE_JWT_ALGORITHMS=HS256
# Purpose: Configures allow low confidence identity fallback.
ALLOW_LOW_CONFIDENCE_IDENTITY_FALLBACK=true
# Purpose: Feature flag controlling rate limit enabled.
RATE_LIMIT_ENABLED=true
# Purpose: Time limit for rate limit window seconds, in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# Purpose: Numeric runtime limit for rate limit auth start max.
RATE_LIMIT_AUTH_START_MAX=240
# Purpose: Numeric runtime limit for rate limit auth callback max.
RATE_LIMIT_AUTH_CALLBACK_MAX=240
# Purpose: Numeric runtime limit for rate limit auth refresh max.
RATE_LIMIT_AUTH_REFRESH_MAX=90
# Purpose: Numeric runtime limit for rate limit auth logout max.
RATE_LIMIT_AUTH_LOGOUT_MAX=90
# Purpose: Numeric runtime limit for rate limit module redeem max.
RATE_LIMIT_MODULE_REDEEM_MAX=240

# Purpose: Feature flag controlling enable auto sync loop.
ENABLE_AUTO_SYNC_LOOP=false
# Purpose: Time limit for auto sync interval seconds, in seconds.
AUTO_SYNC_INTERVAL_SECONDS=300
# Purpose: Configures auto sync max tenants.
AUTO_SYNC_MAX_TENANTS=200
# Purpose: Configures auto sync max users per tenant.
AUTO_SYNC_MAX_USERS_PER_TENANT=200
# Purpose: Feature flag controlling enable startup tenant inventory import.
ENABLE_STARTUP_TENANT_INVENTORY_IMPORT=false
# Purpose: Feature flag controlling enable startup eappraisal tenant inventory import.
ENABLE_STARTUP_EAPPRAISAL_TENANT_INVENTORY_IMPORT=false
# Purpose: Configures startup tenant inventory max records.
STARTUP_TENANT_INVENTORY_MAX_RECORDS=500
# Purpose: Configures tenant reconciliation aliases json.
TENANT_RECONCILIATION_ALIASES_JSON={}

# Purpose: Feature flag controlling enable auto provision.
ENABLE_AUTO_PROVISION=false
# Purpose: Configures auto provision dry run.
AUTO_PROVISION_DRY_RUN=true
# Purpose: Configures auto provision allowed modules.
AUTO_PROVISION_ALLOWED_MODULES=eappraisal,eleave
# Purpose: Configures auto provision max actions per run.
AUTO_PROVISION_MAX_ACTIONS_PER_RUN=100
# Purpose: Configures auto provision stop on error.
AUTO_PROVISION_STOP_ON_ERROR=true
# Purpose: Configures auto provision audit log path.
AUTO_PROVISION_AUDIT_LOG_PATH=logs/auto_provision_audit.jsonl
# Purpose: Configures eappraisal provision user path.
EAPPRAISAL_PROVISION_USER_PATH=/api/hris/v1/integration/tenants/{tenant_id}/users/provision
# Purpose: Configures eleave provision user path.
ELEAVE_PROVISION_USER_PATH=/api/hris/v1/integration/tenants/{tenant_id}/users/provision

# Purpose: Time limit for http client timeout seconds, in seconds.
HTTP_CLIENT_TIMEOUT_SECONDS=5
# Purpose: Configures federated directory srms max tenants per run.
FEDERATED_DIRECTORY_SRMS_MAX_TENANTS_PER_RUN=25
# Purpose: Time limit for federated directory srms cooldown on 429 seconds, in seconds.
FEDERATED_DIRECTORY_SRMS_COOLDOWN_ON_429_SECONDS=120
# Purpose: Feature flag controlling enable federated keycloak sync.
ENABLE_FEDERATED_KEYCLOAK_SYNC=false
# Purpose: Configures startup federated enrollment mode.
# Options: disabled | discover | apply.
# Purpose: Configures startup federated enrollment mode.
# Options: disabled | discover | apply.
# Purpose: Configures startup federated enrollment mode.
# Options: disabled | discover | apply.
# Purpose: Configures startup federated enrollment mode.
# Options: disabled | discover | apply.
STARTUP_FEDERATED_ENROLLMENT_MODE=disabled
# Purpose: Configures federated keycloak sync dry run.
FEDERATED_KEYCLOAK_SYNC_DRY_RUN=true
# Purpose: Configures federated keycloak sync max users per run.
FEDERATED_KEYCLOAK_SYNC_MAX_USERS_PER_RUN=0
ENROLLMENT_WORKER_ENABLED=true
# Global enrollment jobs refresh SRMS/eAppraisal tenants before discovering users.
ENROLLMENT_REFRESH_TENANT_INVENTORY=true
ENROLLMENT_EMAIL_MAX_ATTEMPTS=3
ENROLLMENT_EMAIL_RETRY_BASE_SECONDS=30
# Purpose: Feature flag controlling enable federated keycloak welcome email.
ENABLE_FEDERATED_KEYCLOAK_WELCOME_EMAIL=false
# Purpose: Secret/configuration for federated keycloak allow existing user password reset; inject securely and never commit a real value.
FEDERATED_KEYCLOAK_ALLOW_EXISTING_USER_PASSWORD_RESET=false
# Purpose: Network location used for automation store database url.
AUTOMATION_STORE_DATABASE_URL=postgresql://hris:hris_secret@localhost:5432/hris_tenant_registry
# Purpose: Configures automation store schema.
AUTOMATION_STORE_SCHEMA=hris_automation
# Purpose: Configures db auto create on startup.
DB_AUTO_CREATE_ON_STARTUP=true
# Purpose: Network location used for db bootstrap admin url.
DB_BOOTSTRAP_ADMIN_URL=
# Purpose: Configures db bootstrap admin database.
DB_BOOTSTRAP_ADMIN_DATABASE=postgres
# Purpose: Numeric runtime limit for db bootstrap connect retries.
DB_BOOTSTRAP_CONNECT_RETRIES=5
# Purpose: Time limit for db bootstrap retry delay seconds, in seconds.
DB_BOOTSTRAP_RETRY_DELAY_SECONDS=2
# Purpose: Time limit for db bootstrap timeout seconds, in seconds.
DB_BOOTSTRAP_TIMEOUT_SECONDS=5
# Purpose: Time limit for startup pause after db create seconds, in seconds.
STARTUP_PAUSE_AFTER_DB_CREATE_SECONDS=0
# Purpose: Feature flag controlling enable post deploy sync automation.
ENABLE_POST_DEPLOY_SYNC_AUTOMATION=false
# Purpose: Feature flag controlling post deploy welcome emails enabled.
POST_DEPLOY_WELCOME_EMAILS_ENABLED=false
# Purpose: Configures onboarding auto sync new tenants.
ONBOARDING_AUTO_SYNC_NEW_TENANTS=true
# Purpose: Configures onboarding auto keycloak provision.
ONBOARDING_AUTO_KEYCLOAK_PROVISION=false
# Purpose: Feature flag controlling onboarding welcome email enabled.
ONBOARDING_WELCOME_EMAIL_ENABLED=false
# Purpose: Configures onboarding welcome max users per tenant.
ONBOARDING_WELCOME_MAX_USERS_PER_TENANT=2000
# Purpose: Secret/configuration for onboarding send temp password email; inject securely and never commit a real value.
ONBOARDING_SEND_TEMP_PASSWORD_EMAIL=false
# Purpose: Secret/configuration for onboarding temp password length; inject securely and never commit a real value.
ONBOARDING_TEMP_PASSWORD_LENGTH=14
# Purpose: Secret/configuration for onboarding dev credentials export enabled; inject securely and never commit a real value.
ONBOARDING_DEV_CREDENTIALS_EXPORT_ENABLED=false
# Purpose: Secret/configuration for onboarding dev credentials export path; inject securely and never commit a real value.
ONBOARDING_DEV_CREDENTIALS_EXPORT_PATH=data/exports
# Purpose: Secret/configuration for onboarding dev force temp password; inject securely and never commit a real value.
ONBOARDING_DEV_FORCE_TEMP_PASSWORD=false
# Purpose: Configures storage provider stack.
STORAGE_PROVIDER_STACK=s3,local
# Purpose: Time limit for storage healthcheck ttl seconds, in seconds.
STORAGE_HEALTHCHECK_TTL_SECONDS=300
# Purpose: Configures media local base path.
MEDIA_LOCAL_BASE_PATH=data/media
# Purpose: Configures s3 bucket.
S3_BUCKET=
# Purpose: Configures s3 region.
S3_REGION=
# Purpose: Secret/configuration for s3 access key id; inject securely and never commit a real value.
S3_ACCESS_KEY_ID=
# Purpose: Secret/configuration for s3 secret access key; inject securely and never commit a real value.
S3_SECRET_ACCESS_KEY=
# Purpose: Network location used for s3 endpoint url.
S3_ENDPOINT_URL=
# Purpose: Configures s3 prefix.
S3_PREFIX=

# Purpose: Network location used for smtp host.
SMTP_HOST=
# Purpose: Numeric runtime limit for smtp port.
SMTP_PORT=587
# Purpose: Configures smtp username.
SMTP_USERNAME=
# Purpose: Secret/configuration for smtp password; inject securely and never commit a real value.
SMTP_PASSWORD=
# Purpose: Configures smtp use tls.
# Options: true for STARTTLS; false when implicit SSL is used.
# Purpose: Configures smtp use tls.
# Options: true for STARTTLS; false when implicit SSL is used.
# Purpose: Configures smtp use tls.
# Options: true for STARTTLS; false when implicit SSL is used.
# Purpose: Configures smtp use tls.
# Options: true for STARTTLS; false when implicit SSL is used.
SMTP_USE_TLS=true
# Purpose: Configures smtp use ssl.
# Options: false for port 587 STARTTLS; true commonly uses port 465.
# Purpose: Configures smtp use ssl.
# Options: false for port 587 STARTTLS; true commonly uses port 465.
# Purpose: Configures smtp use ssl.
# Options: false for port 587 STARTTLS; true commonly uses port 465.
# Purpose: Configures smtp use ssl.
# Options: false for port 587 STARTTLS; true commonly uses port 465.
SMTP_USE_SSL=false
# Purpose: Secret/configuration for smtp use credentials; inject securely and never commit a real value.
SMTP_USE_CREDENTIALS=true
# Purpose: Configures smtp validate certs.
SMTP_VALIDATE_CERTS=true
# Purpose: Configures smtp from email.
SMTP_FROM_EMAIL=noreply@hris.local
# Purpose: Secret/configuration for password reset action lifespan seconds; inject securely and never commit a real value.
PASSWORD_RESET_ACTION_LIFESPAN_SECONDS=900
# Purpose: Secret/configuration for password reset rate limit max; inject securely and never commit a real value.
PASSWORD_RESET_RATE_LIMIT_MAX=5
# Purpose: Configures keycloak manage realm email settings.
KEYCLOAK_MANAGE_REALM_EMAIL_SETTINGS=false
# Set only after the matching theme is installed in the Keycloak server.
KEYCLOAK_EMAIL_THEME=
# Purpose: Configures welcome email subject template.
WELCOME_EMAIL_SUBJECT_TEMPLATE=Welcome to {brand_name} - {tenant_name}
# Purpose: Configures welcome email body template.
WELCOME_EMAIL_BODY_TEMPLATE=Welcome to {brand_name} for {tenant_name}.\n\nPortal URL: {portal_url}\nUsername: {username}\n{password_line}\nSupport: {support_email}\n
# Purpose: Configures tenant brand name default.
TENANT_BRAND_NAME_DEFAULT=HRIS
# Purpose: Configures tenant support email default.
TENANT_SUPPORT_EMAIL_DEFAULT=support@hris.local

# Purpose: Configures keycloak realm.
KEYCLOAK_REALM=hris-platform
# Purpose: Configures keycloak admin realm.
KEYCLOAK_ADMIN_REALM=master
# Purpose: Configures keycloak admin client id.
KEYCLOAK_ADMIN_CLIENT_ID=
# Purpose: Secret/configuration for keycloak admin client secret; inject securely and never commit a real value.
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Purpose: Configures keycloak admin username.
KEYCLOAK_ADMIN_USERNAME=
# Purpose: Secret/configuration for keycloak admin password; inject securely and never commit a real value.
KEYCLOAK_ADMIN_PASSWORD=
# Purpose: Feature flag controlling bootstrap admin enabled.
BOOTSTRAP_ADMIN_ENABLED=false
# Purpose: Configures bootstrap superadmin username.
BOOTSTRAP_SUPERADMIN_USERNAME=
# Purpose: Configures bootstrap superadmin email.
BOOTSTRAP_SUPERADMIN_EMAIL=
# Purpose: Secret/configuration for bootstrap superadmin password; inject securely and never commit a real value.
BOOTSTRAP_SUPERADMIN_PASSWORD=
# Purpose: Configures bootstrap superadmin tenant id.
BOOTSTRAP_SUPERADMIN_TENANT_ID=
# Purpose: Configures bootstrap tenantadmin username.
BOOTSTRAP_TENANTADMIN_USERNAME=
# Purpose: Configures bootstrap tenantadmin email.
BOOTSTRAP_TENANTADMIN_EMAIL=
# Purpose: Secret/configuration for bootstrap tenantadmin password; inject securely and never commit a real value.
BOOTSTRAP_TENANTADMIN_PASSWORD=
# Purpose: Configures bootstrap tenantadmin tenant id.
BOOTSTRAP_TENANTADMIN_TENANT_ID=
# If you later add logging, etc., add variables here

# --- Automatically synchronized settings coverage ---
# Purpose: Configures dev default tenant id.
DEV_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
# Purpose: Configures dev default username.
DEV_DEFAULT_USERNAME=dev.admin
# Purpose: Configures dev default roles.
DEV_DEFAULT_ROLES=hris:hr_manager
# Purpose: Configures dev default employee id.
DEV_DEFAULT_EMPLOYEE_ID=e001
# Purpose: Configures eappraisal fixture file.
EAPPRAISAL_FIXTURE_FILE=
# Purpose: Configures eappraisal fixture employee id.
EAPPRAISAL_FIXTURE_EMPLOYEE_ID=e001
# Purpose: Configures module adapter mode.
MODULE_ADAPTER_MODE=auto
# Purpose: Configures use stub data.
USE_STUB_DATA=false
# Purpose: Feature flag controlling enable jit module setup.
ENABLE_JIT_MODULE_SETUP=false
# Purpose: Configures jit auto enable modules.
JIT_AUTO_ENABLE_MODULES=eappraisal,eleave
# Purpose: Feature flag controlling jit auto bootstrap enabled.
JIT_AUTO_BOOTSTRAP_ENABLED=true
# Purpose: Configures jit max actions per request.
JIT_MAX_ACTIONS_PER_REQUEST=10
# Purpose: Time limit for jit cooldown seconds, in seconds.
JIT_COOLDOWN_SECONDS=30
# Purpose: Configures superadmin onboard allowed groups.
HRIS_SUPERADMIN_ONBOARD_ALLOWED_GROUPS=
# Purpose: Configures superadmin onboard group bootstrap done.
HRIS_SUPERADMIN_ONBOARD_GROUP_BOOTSTRAP_DONE=
# Purpose: Secret/configuration for expose temporary password in api; inject securely and never commit a real value.
EXPOSE_TEMPORARY_PASSWORD_IN_API=
