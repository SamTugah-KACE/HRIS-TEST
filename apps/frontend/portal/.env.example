# Purpose: Network location used for hris core api base url.
VITE_HRIS_CORE_API_BASE_URL=http://localhost:8000
# Purpose: Network location used for hris gateway api base url.
VITE_HRIS_GATEWAY_API_BASE_URL=http://localhost:8010
# Purpose: Configures use graphql gateway.
VITE_USE_GRAPHQL_GATEWAY=false
# Purpose: Configures auth mode.
# Options: keycloak for product UI; dev only for isolated UI work.
# Purpose: Configures auth mode.
# Options: keycloak for product UI; dev only for isolated UI work.
# Purpose: Configures auth mode.
# Options: keycloak for product UI; dev only for isolated UI work.
# Purpose: Configures auth mode.
# Options: keycloak for product UI; dev only for isolated UI work.
VITE_AUTH_MODE=keycloak
# Purpose: Configures auth csrf header name.
VITE_AUTH_CSRF_HEADER_NAME=X-CSRF-Token
# Purpose: Configures portal data mode.
VITE_PORTAL_DATA_MODE=api
# Purpose: Configures dev require login.
VITE_DEV_REQUIRE_LOGIN=false
# Purpose: Configures dev default tenant id.
VITE_DEV_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
# Purpose: Configures dev default employee id.
VITE_DEV_DEFAULT_EMPLOYEE_ID=e001
