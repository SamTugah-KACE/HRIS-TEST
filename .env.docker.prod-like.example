# Copy to ".env.docker.prod-like" and load before docker compose.
# PowerShell example:
#   Get-Content ".env.docker.prod-like" | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -notmatch '=') { return }
#     $name, $value = $_ -split '=', 2
#     [System.Environment]::SetEnvironmentVariable($name, $value)
#   }

# --- HRIS runtime mode ---
HRIS_APP_ENV=staging
HRIS_AUTH_MODE=keycloak
HRIS_USE_STUB_DATA=false
HRIS_DEV_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
HRIS_DEV_DEFAULT_USERNAME=dev.admin
HRIS_DEV_DEFAULT_ROLES=hris:super_admin

# --- Tenant registry wiring ---
HRIS_TENANT_REGISTRY_BASE_URL=http://tenant-registry:8000
HRIS_TENANT_REGISTRY_BASIC_AUTH_USERNAME=hris_internal
HRIS_TENANT_REGISTRY_BASIC_AUTH_PASSWORD=registry_secret
HRIS_TENANT_REGISTRY_ALLOW_FALLBACK=false
HRIS_TENANT_REGISTRY_STARTUP_WAIT_FAIL_OPEN=false

# --- Auth and UI integration ---
HRIS_KEYCLOAK_ISSUER=http://localhost:8080/realms/hris-platform
HRIS_KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/hris-platform/protocol/openid-connect/certs
HRIS_KEYCLOAK_AUDIENCE_HRIS_CORE=account,hris-core-api,hris-portal
HRIS_KEYCLOAK_CLIENT_ID_PORTAL=hris-portal
HRIS_KEYCLOAK_CLIENT_SECRET_PORTAL=
HRIS_PORTAL_BASE_URL=http://localhost:3000
HRIS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HRIS_AUTH_STATE_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
HRIS_AUTH_COOKIE_SECURE=false
HRIS_AUTH_COOKIE_SAMESITE=lax
HRIS_AUTH_CSRF_ENABLED=true

# --- SRMS integration ---
HRIS_SRMS_BASE_URL=https://srms.gi-kace.com.gh
HRIS_SRMS_APP_TYPE=superadmin
HRIS_SRMS_AUTO_SESSION_TOKEN=true
HRIS_SRMS_INTEGRATION_TOKEN=
HRIS_SRMS_SERVICE_TOKEN=
HRIS_SRMS_HRIS_SHARED_SECRET=REPLACE_WITH_SHARED_SECRET
HRIS_SRMS_HRIS_SERVICE_TOKEN=REPLACE_WITH_SERVICE_TOKEN

# --- Startup import and sync loops ---
HRIS_ENABLE_STARTUP_TENANT_INVENTORY_IMPORT=true
HRIS_STARTUP_TENANT_INVENTORY_MAX_RECORDS=500
HRIS_ENABLE_AUTO_SYNC_LOOP=true
HRIS_AUTO_SYNC_INTERVAL_SECONDS=300
HRIS_AUTO_SYNC_MAX_TENANTS=200
HRIS_AUTO_SYNC_MAX_USERS_PER_TENANT=200

# --- Auto-provision safety ---
HRIS_ENABLE_AUTO_PROVISION=true
HRIS_AUTO_PROVISION_DRY_RUN=true
HRIS_AUTO_PROVISION_ALLOWED_MODULES=eappraisal,eleave
HRIS_AUTO_PROVISION_MAX_ACTIONS_PER_RUN=100
HRIS_AUTO_PROVISION_STOP_ON_ERROR=true

# --- Onboarding and welcome automation ---
HRIS_AUTOMATION_STORE_DATABASE_URL=postgresql://hris:hris_secret@postgres:5432/hris_tenant_registry
HRIS_AUTOMATION_STORE_SCHEMA=hris_automation
HRIS_DB_AUTO_CREATE_ON_STARTUP=true
HRIS_DB_BOOTSTRAP_ADMIN_URL=postgresql://hris:hris_secret@postgres:5432/postgres
HRIS_DB_BOOTSTRAP_ADMIN_DATABASE=postgres
HRIS_DB_BOOTSTRAP_CONNECT_RETRIES=5
HRIS_DB_BOOTSTRAP_RETRY_DELAY_SECONDS=2
HRIS_DB_BOOTSTRAP_TIMEOUT_SECONDS=5
HRIS_ENABLE_POST_DEPLOY_SYNC_AUTOMATION=false
HRIS_POST_DEPLOY_WELCOME_EMAILS_ENABLED=true
HRIS_ONBOARDING_AUTO_SYNC_NEW_TENANTS=true
HRIS_ONBOARDING_AUTO_KEYCLOAK_PROVISION=true
HRIS_ONBOARDING_WELCOME_EMAIL_ENABLED=false
HRIS_ONBOARDING_WELCOME_MAX_USERS_PER_TENANT=2000
HRIS_ONBOARDING_SEND_TEMP_PASSWORD_EMAIL=false
HRIS_ONBOARDING_TEMP_PASSWORD_LENGTH=14
HRIS_ONBOARDING_DEV_CREDENTIALS_EXPORT_ENABLED=false
HRIS_ONBOARDING_DEV_CREDENTIALS_EXPORT_PATH=data/exports
HRIS_ONBOARDING_DEV_FORCE_TEMP_PASSWORD=false
HRIS_EXPOSE_TEMPORARY_PASSWORD_IN_API=false
HRIS_STORAGE_PROVIDER_STACK=s3,local
HRIS_STORAGE_HEALTHCHECK_TTL_SECONDS=300
HRIS_MEDIA_LOCAL_BASE_PATH=data/media
HRIS_S3_BUCKET=
HRIS_S3_REGION=
HRIS_S3_ACCESS_KEY_ID=
HRIS_S3_SECRET_ACCESS_KEY=
HRIS_S3_ENDPOINT_URL=
HRIS_S3_PREFIX=
HRIS_KEYCLOAK_REALM=hris-platform
HRIS_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
HRIS_KEYCLOAK_ADMIN_CLIENT_SECRET=
HRIS_KEYCLOAK_ADMIN_USERNAME=admin
HRIS_KEYCLOAK_ADMIN_PASSWORD=admin
HRIS_SUPERADMIN_ONBOARD_ALLOWED_GROUPS=
HRIS_SUPERADMIN_ONBOARD_GROUP_BOOTSTRAP_DONE=false
HRIS_SMTP_HOST=
HRIS_SMTP_PORT=587
HRIS_SMTP_USERNAME=
HRIS_SMTP_PASSWORD=
HRIS_SMTP_USE_TLS=true
HRIS_SMTP_FROM_EMAIL=noreply@hris.local
HRIS_TENANT_BRAND_NAME_DEFAULT=HRIS
HRIS_TENANT_SUPPORT_EMAIL_DEFAULT=support@hris.local

# When welcome email automation is enabled and SMTP is configured,
# credentials should be delivered by email (not local txt exports).
# Recommended secure defaults:
#   HRIS_ONBOARDING_WELCOME_EMAIL_ENABLED=true
#   HRIS_POST_DEPLOY_WELCOME_EMAILS_ENABLED=true
#   HRIS_ONBOARDING_SEND_TEMP_PASSWORD_EMAIL=true
#   HRIS_ONBOARDING_DEV_CREDENTIALS_EXPORT_ENABLED=false

# --- Portal build args ---
PORTAL_VITE_HRIS_CORE_API_BASE_URL=http://localhost:8000
PORTAL_VITE_AUTH_MODE=keycloak
